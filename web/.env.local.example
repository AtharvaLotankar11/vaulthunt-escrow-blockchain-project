# Copy to .env.local (never commit .env.local). Everything here is optional.

# Use the public test network instead of the local chain:
# NEXT_PUBLIC_DEFAULT_CHAIN=sepolia
# NEXT_PUBLIC_SEPOLIA_RPC=   (your Alchemy Sepolia link; it ends up in the browser, fine for a free test key)

# Real IPFS storage for reports (server side only). Leave empty to use the local store.
PINATA_JWT=
