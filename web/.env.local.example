# Copy to .env.local (never commit .env.local). Everything here is optional on your own computer.
# On Vercel, enter the same names as Environment Variables in the project settings (see DEPLOY.md).

# Use the public test network instead of the local chain:
# NEXT_PUBLIC_DEFAULT_CHAIN=sepolia
# NEXT_PUBLIC_SEPOLIA_RPC=   (your Alchemy Sepolia link; it ends up in the browser, fine for a free test key)

# Real IPFS storage for reports (server side only). Required on Vercel; leave empty on your own computer to use the local folder.
PINATA_JWT=
# Optional: your Pinata gateway, for example https://your-name.mypinata.cloud/ipfs (the public gateway is used if empty)
# IPFS_GATEWAY=

# Optional: the public address of the deployed site, so the share card works (for example https://vaulthunt.vercel.app)
# NEXT_PUBLIC_SITE_URL=
